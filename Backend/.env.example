# ==============================================================================
# CIGHT-BROWSER Environment Configuration (.env.example)
# NFR-SEC-02 / NFR-OPS-01
# ==============================================================================

# Django Secret Key & Debug Mode
SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database (CON-04)
# When unset in local testing, falls back to SQLite for pytest runs
DATABASE_URL=postgres://cight:cight_secret@127.0.0.1:5432/cight_db

# Redis for Channels Layer and Celery Task Broker
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# AI Configuration (SRS §2.5, TBD-02)
# Google Gemini API key and fallback model chains (priority order)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_TASK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash,gemini-3.6-flash
GEMINI_PERCEPTION_MODELS=gemini-3.6-flash,gemini-3.8-flash,gemini-3.5-flash-lite
GEMINI_TRANSCRIBE_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash
TRANSCRIBE_ATTEMPT_TIMEOUT_SECONDS=8
MAX_AUDIO_SECONDS=20

# Operational Limits and Thresholds (NFR-OPS-02)
LOOP_REPEAT_LIMIT=3
CONSECUTIVE_FAILURE_LIMIT=3
ACTION_TIMEOUT_SECONDS=30
LLM_TIMEOUT_SECONDS=30
PERCEPTION_ATTEMPT_TIMEOUT_SECONDS=15
TASK_ATTEMPT_TIMEOUT_SECONDS=12
MODEL_TIMEOUT_COOLDOWN_SECONDS=600
CONFIRMATION_EXPIRY_SECONDS=120
TASK_MAX_STEPS=50
# true = no visible Chromium window (recommended for real blind users)
# false = visible window (demos and debugging). Development default is false.
BROWSER_HEADLESS=False
BROWSER_IDLE_SECONDS=900
BROWSER_WORKER_QUEUE=
BROWSER_TASK_TIMEOUT_SECONDS=1800
SCREENSHOT_RETENTION_DAYS=7

# Server-side Browser Profile Storage (FR-52..54)
BROWSER_PROFILE_ROOT=/tmp/cight_browser_profiles

# Frontend & WebSocket Configuration (Milestone 4)
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WS_TICKET_TTL_SECONDS=60
WS_MAX_MESSAGE_BYTES=4096
COOKIE_SECURE=False

