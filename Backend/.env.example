# ==============================================================================
# CIGHT-BROWSER Environment Configuration (.env.example)
# NFR-SEC-02 / NFR-OPS-01
# ==============================================================================

# Django Secret Key & Debug Mode
SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database (CON-04)
# When unset in local testing, falls back to SQLite for pytest runs
DATABASE_URL=postgres://cight:cight_secret@127.0.0.1:5432/cight_db

# Redis for Channels Layer and Celery Task Broker
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# AI Configuration (SRS §2.5, TBD-02)
# Google Gemini API key and model selection
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash

# Operational Limits and Thresholds (NFR-OPS-02)
LOOP_REPEAT_LIMIT=3
CONSECUTIVE_FAILURE_LIMIT=3
ACTION_TIMEOUT_SECONDS=30
LLM_TIMEOUT_SECONDS=30
CONFIRMATION_EXPIRY_SECONDS=120
TASK_MAX_STEPS=50
BROWSER_HEADLESS=False

# Server-side Browser Profile Storage (FR-52..54)
BROWSER_PROFILE_ROOT=/tmp/cight_browser_profiles

